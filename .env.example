# LLM Configuration
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-coder-3b-instruct

# Server
APP_PORT=8000

# Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
SKILLS_DIR=skills

# Output Naming
OUTPUT_PREFIX=skillforge
OUTPUT_SUFFIX=

# Self-correction: total LLM attempts per transform
# 1 = generate only (no correction), 2 = one retry if validation fails
SELF_CORRECT_MAX_ATTEMPTS=2

# Logging
LOG_LEVEL=INFO

# LangSmith Tracing (optional — leave LANGSMITH_TRACING=false to disable)
# Get an API key at https://smith.langchain.com/ (Settings -> API Keys)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skillforge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
